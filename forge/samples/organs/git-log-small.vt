 pub fn socket_path() -> PathBuf {[m
     match std::env::var_os("PROTEUS_SOCKET") {[m
         Some(p) if !p.is_empty() => PathBuf::from(p),[m
[31m-        _ => crate::paths::data_dir().join("proteusd.sock"),[m
